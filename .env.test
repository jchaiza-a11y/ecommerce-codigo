# Valores dummy para que los módulos que leen `process.env` en el top-level
# (ej. src/server/db/index.ts, src/lib/stripe.ts, src/lib/app-url.ts) no
# revienten al importarse durante `node --test`. Ningún test debe pegarle de
# verdad a Neon/Stripe/Clerk: lo que necesite esas piezas las mockea con
# `node:test`'s mock.module() apuntando a src/test/mocks/.
DATABASE_URL="postgresql://test:test@localhost:5432/test"
STRIPE_SECRET_KEY="sk_test_dummy"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_dummy"
CLERK_SECRET_KEY="sk_test_dummy"
